    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.19.0",
    "@react-pdf/renderer": "^3.4.5",
    "@resvg/resvg-js": "^2.6.2",
    "@veramo/core": "^5.5.2",
    "@veramo/credential-w3c": "^5.5.2",
    "@veramo/did-manager": "^5.5.2",
    "@veramo/did-provider-web": "^5.5.2",
    "@veramo/did-resolver": "^5.5.2",
    "@veramo/kms-local": "^5.5.2",
