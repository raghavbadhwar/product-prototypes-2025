    "@types/react": "^18.3.5",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
